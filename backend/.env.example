# Application
APP_NAME=trident-virtual-ai-backend
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database connection
DB_HOST=localhost
DB_PORT=5433
DB_NAME=trident_virtual_ai
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Chat feature gates
CHAT_DOCUMENTS_RESPONDER_ENABLED=false
CHAT_VOICE_MAX_UPLOAD_BYTES=10485760
CHAT_VOICE_MAX_DURATION_MS=120000

# Documents
DOCUMENTS_PARSE_DRAIN_ENABLED=true
DOCUMENTS_PARSE_DRAIN_INTERVAL_MS=15000

# Influx integration
INFLUX_URL=
INFLUX_ORG=
INFLUX_TOKEN=
INFLUX_SCHEMA_LOOKBACK=-3650d

# Grafana metric descriptions
GRAFANA_SA_TOKEN=

# Optional general LLM integration
RAG_PROVIDER=local
RAG_INDEX_NAME=
# Web search has no settings: it runs as Anthropic's server-side tool on the
# main model, so LLM_MODEL + ANTHROPIC_API_KEY are all it needs.
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# Anthropic Claude — automatically used when LLM_MODEL starts with "claude-".
# Examples: claude-opus-4-7  ·  claude-sonnet-4-6  ·  claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=
